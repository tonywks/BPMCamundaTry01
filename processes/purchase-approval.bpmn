<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_purchase" targetNamespace="http://example.com/procureflow">
  <bpmn:process id="purchase-approval" name="Purchase approval" isExecutable="true">
    <bpmn:startEvent id="start" name="Request submitted"><bpmn:outgoing>flow_start_dmn</bpmn:outgoing></bpmn:startEvent>
    <bpmn:businessRuleTask id="route" name="Evaluate approval routing"><bpmn:extensionElements><zeebe:calledDecision decisionId="approval-routing" resultVariable="routing" /></bpmn:extensionElements><bpmn:incoming>flow_start_dmn</bpmn:incoming><bpmn:outgoing>flow_dmn_manager</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:userTask id="manager_approval" name="Manager approval"><bpmn:extensionElements><zeebe:assignmentDefinition assignee="manager" /></bpmn:extensionElements><bpmn:incoming>flow_dmn_manager</bpmn:incoming><bpmn:outgoing>flow_manager_end</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="end" name="Approval completed"><bpmn:incoming>flow_manager_end</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_dmn" sourceRef="start" targetRef="route" />
    <bpmn:sequenceFlow id="flow_dmn_manager" sourceRef="route" targetRef="manager_approval" />
    <bpmn:sequenceFlow id="flow_manager_end" sourceRef="manager_approval" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
